{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "JARVIS Companion",
  "version": "0.1.0",
  "identifier": "com.hypermind.jarvis.companion",
  "build": {
    "frontendDist": "../dist",
    "beforeBuildCommand": "node scripts/build-frontend.mjs",
    "beforeDevCommand": "node scripts/build-frontend.mjs"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self'; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; frame-src 'none'; form-action 'none'",
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage", "msi", "dmg", "app"],
    "category": "Utility",
    "shortDescription": "JARVIS's desktop presence",
    "longDescription": "A small pixel-art JARVIS that sits on the desktop and presents JARVIS's operational activity. It never approves, confirms or runs anything.",
    "publisher": "Hypermind",
    "copyright": "Hypermind",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "linux": {
      "deb": { "depends": ["libayatana-appindicator3-1"] }
    },
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true }
    }
  }
}
