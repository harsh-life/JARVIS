# The Browser Use runtime image (OD-AF-6, OD-AF-14; docs/29 §21).
#
# Built and published by CI (.github/workflows/runtime-image.yml), never on a
# self-hoster's machine, and run only by its immutable digest: the launcher
# refuses any reference that is not name@sha256:<digest> and never pulls at
# run time. The digest it runs is recorded in the repository
# (server/agents/registry/runtimes.py), and every upgrade is a reviewed PR.
#
# - the base image is pinned by digest;
# - every Python dependency is installed from requirements.lock with
#   --require-hashes (generated by `uv pip compile --generate-hashes` from
#   requirements.in: browser-use==0.13.10);
# - telemetry and cloud sync are off by default here and in the entrypoint,
#   and unreachable anyway: the container has no network interface;
# - no credentials, no browser profile, nothing of the build host's.
#
# The container runs as the JARVIS server's own uid (podman --userns=keep-id),
# so every file here is world-readable and nothing here is writable.

FROM docker.io/library/python:3.12-slim-bookworm@sha256:54c85f3c47607a77f32adec749d3c81d1348bf25833671f512b26a9b6d778cb3

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    ANONYMIZED_TELEMETRY=false \
    BROWSER_USE_CLOUD_SYNC=false \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

RUN apt-get update \
 && apt-get install -y --no-install-recommends chromium fonts-liberation ca-certificates \
 && rm -rf /var/lib/apt/lists/*

COPY requirements.lock /opt/jarvis/requirements.lock
RUN python -m pip install --no-deps --require-hashes -r /opt/jarvis/requirements.lock

COPY protocol.py forwarder.py jarvis_llm.py entrypoint.py /opt/jarvis/
RUN chmod -R a+rX,go-w /opt/jarvis

WORKDIR /opt/jarvis
ENTRYPOINT ["python", "/opt/jarvis/entrypoint.py"]
