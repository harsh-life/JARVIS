{
  "schema": "jarvis-character-rig-contract/1",
  "description": "How the JARVIS presentation controller drives JarvisCharacter. The controller decides the state; this rig only animates and renders it. See docs/INTEGRATION.md.",
  "files": {
    "skeleton_binary": "JarvisCharacter.skel",
    "skeleton_json": "JarvisCharacter.json",
    "atlas": "JarvisCharacter.atlas",
    "atlas_page": "JarvisCharacter.png",
    "format": "Rigby2D skeleton 4.3 (binary .skel and JSON hold the same data)"
  },
  "states": [
    "happy",
    "satisfied",
    "default",
    "sleepy",
    "surprised",
    "angry",
    "sad"
  ],
  "fallback_state": "default",
  "tracks": {
    "0": "expression track: idle_*, to_*, trans_*, long_idle_* (exactly one plays at a time)",
    "1": "overlay track: enter, exit (body scale only; layered over track 0)"
  },
  "idle": {
    "happy": "idle_happy",
    "satisfied": "idle_satisfied",
    "default": "idle_default",
    "sleepy": "idle_sleepy",
    "surprised": "idle_surprised",
    "angry": "idle_angry",
    "sad": "idle_sad"
  },
  "long_idle": {
    "happy": "long_idle_happy",
    "satisfied": "long_idle_satisfied",
    "default": "long_idle_default",
    "sleepy": "long_idle_sleepy",
    "surprised": "long_idle_surprised",
    "angry": "long_idle_angry",
    "sad": "long_idle_sad"
  },
  "entry": {
    "happy": "to_happy",
    "satisfied": "to_satisfied",
    "default": "to_default",
    "sleepy": "to_sleepy",
    "surprised": "to_surprised",
    "angry": "to_angry",
    "sad": "to_sad"
  },
  "pair_transitions": {
    "happy>satisfied": "trans_happy_to_satisfied",
    "surprised>default": "trans_surprised_to_default",
    "angry>satisfied": "trans_angry_to_satisfied",
    "sad>happy": "trans_sad_to_happy",
    "sleepy>default": "trans_sleepy_to_default"
  },
  "transition_rule": "From state A to state B: play pair_transitions[\"A>B\"] if it exists, otherwise entry[B]; then queue idle[B].",
  "overlay": {
    "enter": "enter",
    "exit": "exit"
  },
  "mix_seconds": {
    "into_entry": 0.3,
    "into_pair_transition": 0.15,
    "transition_to_idle": 0.2,
    "into_long_idle": 0.3,
    "long_idle_to_idle": 0.4,
    "interrupt": 0.15,
    "reduced_motion": 0
  },
  "face_swap": "Expression faces are attachment keys inside the animations. With a crossfade of m seconds the face changes at m/2, inside a blink the animation keys; keep m <= 0.5.",
  "animations": {
    "idle_happy": {
      "duration": 2.4,
      "loop": true,
      "track": 0
    },
    "idle_satisfied": {
      "duration": 4.8,
      "loop": true,
      "track": 0
    },
    "idle_default": {
      "duration": 4,
      "loop": true,
      "track": 0
    },
    "idle_sleepy": {
      "duration": 6,
      "loop": true,
      "track": 0
    },
    "idle_surprised": {
      "duration": 2,
      "loop": true,
      "track": 0
    },
    "idle_angry": {
      "duration": 3.2,
      "loop": true,
      "track": 0
    },
    "idle_sad": {
      "duration": 5.6,
      "loop": true,
      "track": 0
    },
    "to_default": {
      "duration": 0.8,
      "loop": false,
      "track": 0
    },
    "to_happy": {
      "duration": 0.9,
      "loop": false,
      "track": 0
    },
    "to_satisfied": {
