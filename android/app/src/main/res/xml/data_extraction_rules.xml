<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing leaves the device through backup or device transfer: the device
     credential is bound to this installation (03 §4.1), and local grid state
     must never be restored onto a device the server does not know. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
